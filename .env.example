# Existing Ark configuration
ARK_API_KEY=your_ark_api_key

# Doubao Seed TTS 2.0 — use the new-console API key when available
VOLCENGINE_TTS_API_KEY=your_speech_api_key
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0

# Optional voice overrides
VOLCENGINE_TTS_ZH_VOICE=zh_female_xueayi_saturn_bigtts
VOLCENGINE_TTS_EN_VOICE=zh_female_vv_uranus_bigtts

# Legacy speech-console credentials (only needed instead of VOLCENGINE_TTS_API_KEY)
# VOLCENGINE_TTS_APP_ID=your_app_id
# VOLCENGINE_TTS_ACCESS_TOKEN=your_access_token
